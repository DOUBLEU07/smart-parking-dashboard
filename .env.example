# Copy to .env and change every secret before deploying.

HTTP_PORT=8080

POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-this-db-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First owner account (created only when the users table is empty)
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=owner1234

# Demo data: 30 slots, 2 weeks of history, lot at 80% so the 90% alert is one or two cars away.
# Also creates `manager` and `staff` accounts using DEMO_PASSWORD. Set to false for real use.
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234

LOG_LEVEL=INFO

# Demo Mode page (/demo): backend trace, time fast-forward, data reset. Set false in production.
DEMO_MODE=true
